<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="649.0" prefWidth="640.0" style="-fx-background-color: rgba(0,0,0,0.5);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.ui.controllers.ChatController">
    <children>

        <!-- Chat Popup Card -->
        <VBox layoutX="170.0" layoutY="80.0" prefWidth="300.0" prefHeight="490.0" spacing="0"
              style="-fx-background-color: rgba(10,25,45,0.97); -fx-background-radius: 20; -fx-border-color: rgba(77,166,255,0.25); -fx-border-width: 1.2; -fx-border-radius: 20;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="50.0"
                  style="-fx-background-color: rgba(15,41,66,0.95); -fx-background-radius: 20 20 0 0; -fx-padding: 0 16 0 16; -fx-border-color: rgba(77,166,255,0.15); -fx-border-width: 0 0 1 0;">
                <Label text="💬 In-Game Chat" textFill="#e6f3ff"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="closeButton" text="✕" onAction="#handleCloseClick"
                        style="-fx-background-color: transparent; -fx-text-fill: #7fbfff; -fx-font-size: 14px; -fx-cursor: hand;" />
            </HBox>

            <!-- Message History -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
                <content>
                    <VBox fx:id="messageContainer" spacing="10" prefWidth="268.0"
                          style="-fx-padding: 14 14 14 14; -fx-background-color: transparent;">
                        <!-- Messages will be added here dynamically from the controller -->
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Input Area -->
            <HBox alignment="CENTER" spacing="8" prefHeight="55.0"
                  style="-fx-padding: 10 12 10 12; -fx-background-color: rgba(15,41,66,0.95); -fx-background-radius: 0 0 20 20; -fx-border-color: rgba(77,166,255,0.15); -fx-border-width: 1 0 0 0;">
                <Label fx:id="errorLabel" text="" style="-fx-text-fill: #ff6b6b; -fx-font-size: 11px; -fx-padding: 0 12 0 12;" />
                <TextField fx:id="messageInput" HBox.hgrow="ALWAYS" prefHeight="35.0"
                           promptText="Type a message..."
                           style="-fx-background-color: #0f2942; -fx-text-fill: white; -fx-prompt-text-fill: #7fbfff; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(77,166,255,0.25); -fx-padding: 0 12 0 12;" />
                <Button fx:id="sendButton" text="Send" onAction="#handleSendClick" prefHeight="35.0"
                        style="-fx-background-color: linear-gradient(to right, #4da6ff, #1e90ff); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 0 16 0 16;" />
            </HBox>

        </VBox>

    </children>
</AnchorPane>