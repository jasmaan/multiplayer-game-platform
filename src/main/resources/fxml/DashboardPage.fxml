<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!-- Root StackPane lets the settings overlay layer on top of the dashboard -->

<StackPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.ui.controllers.DashboardPageController">

   <!-- ══════════════════════════ MAIN DASHBOARD LAYOUT ══════════════════════════ -->
   <BorderPane style="-fx-background-color: linear-gradient(to bottom right, #0b1f33, #4da6ff);">

      <!-- ─────────────────── LEFT SIDEBAR ─────────────────── -->
      <left>
         <VBox prefHeight="700.0" prefWidth="185.0" style="-fx-background-color: rgba(5,12,24,0.97); -fx-border-color: rgba(77,166,255,0.07); -fx-border-width: 0 1 0 0;">

            <!-- Brand row -->
            <HBox alignment="CENTER" style="-fx-padding: 18 12 18 12;">
               <ImageView fitHeight="80.0" fitWidth="155.0" pickOnBounds="true" preserveRatio="true">
                  <image><Image url="@../images/GameDinoLogoFull.png" /></image>
               </ImageView>
            </HBox>

            <!-- Thin divider -->
            <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.07);">
               <VBox.margin><Insets left="10.0" right="10.0" /></VBox.margin>
            </Region>

            <!-- Nav: Dashboard (active) -->
            <Button maxWidth="1.7976931348623157E308" prefHeight="42.0" style="-fx-background-color: rgba(77,166,255,0.18); -fx-text-fill: #4da6ff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 10; -fx-cursor: hand;" text="  DASHBOARD">
               <VBox.margin><Insets left="10.0" right="10.0" top="12.0" /></VBox.margin>
            </Button>

            <!-- Nav: Settings → opens popup -->
            <Button fx:id="settingsButton" maxWidth="1.7976931348623157E308" onAction="#handleOpenSettings" prefHeight="42.0" style="-fx-background-color: transparent; -fx-text-fill: #7fbfff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  SETTINGS">
               <VBox.margin><Insets left="10.0" right="10.0" top="4.0" /></VBox.margin>
            </Button>

            <!-- Nav: Friends List → opens overlay -->
            <StackPane maxWidth="1.7976931348623157E308">
               <VBox.margin><Insets left="10.0" right="10.0" top="4.0" /></VBox.margin>
               <Button fx:id="friendsButton" maxWidth="1.7976931348623157E308" onAction="#handleOpenFriends" prefHeight="42.0" style="-fx-background-color: transparent; -fx-text-fill: #7fbfff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  FRIENDS" />
               <Circle fx:id="friendsRequestBadge" fill="#f0c040" managed="false" radius="5.0" stroke="#0a1a0a" strokeWidth="1.5" visible="false" StackPane.alignment="CENTER_LEFT">
                  <StackPane.margin><Insets left="6.0" /></StackPane.margin>
               </Circle>
            </StackPane>

            <Region VBox.vgrow="ALWAYS" />

            <!-- User card (expands on click) -->
            <VBox fx:id="userCard" onMouseClicked="#handleUserCardClick" style="-fx-background-color: rgba(4,9,20,0.88); -fx-background-radius: 12; -fx-border-color: rgba(77,166,255,0.12); -fx-border-width: 1; -fx-border-radius: 12; -fx-padding: 12 12 12 10; -fx-cursor: hand;">
               <VBox.margin><Insets bottom="4.0" left="8.0" right="8.0" /></VBox.margin>

               <!-- Summary row: avatar + username/rank -->
               <HBox alignment="CENTER_LEFT" spacing="10.0">

                  <!-- Avatar circle -->
                  <StackPane prefHeight="38.0" prefWidth="38.0" style="-fx-background-color: rgba(10,25,45,0.92); -fx-background-radius: 19; -fx-border-color: rgba(77,166,255,0.4); -fx-border-width: 1.5; -fx-border-radius: 19;">
                     <ImageView fx:id="userAvatarImage" fitHeight="38.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../images/gameDinoLogo.png" /></image>
                        <clip><Circle centerX="19.0" centerY="19.0" radius="19.0" /></clip>
                     </ImageView>
                  </StackPane>

                  <!-- Username + rank -->
                  <VBox alignment="CENTER_LEFT" spacing="3.0" HBox.hgrow="ALWAYS">
                     <Label fx:id="usernameLabel" maxWidth="1.7976931348623157E308" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Player" textFill="#e6f3ff" />
                     <HBox alignment="CENTER_LEFT" spacing="4.0">
                        <ImageView fx:id="rankShieldImage" fitHeight="12.0" fitWidth="12.0" pickOnBounds="true" preserveRatio="true">
                           <image><Image url="@../images/BronzeRankShield.png" /></image>
                        </ImageView>
                        <Label fx:id="rankLabel" style="-fx-font-size: 10px;" text="Bronze" textFill="#888888" />
                     </HBox>
                  </VBox>
               </HBox>

               <!-- Expandable details (hidden until card is clicked) -->
               <VBox fx:id="userCardDetails" managed="false" spacing="5.0" visible="false">
                  <VBox.margin><Insets top="10.0" /></VBox.margin>
                  <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.12);">
                     <VBox.margin><Insets bottom="4.0" /></VBox.margin>
                  </Region>
                  <Label fx:id="userCardFullNameLabel" style="-fx-font-size: 11px;" text="" textFill="#b9d9ff" />
                  <Label fx:id="userCardJoinDateLabel" style="-fx-font-size: 10px;" text="" textFill="#3d6080" />
                  <Label fx:id="userCardMmrLabel" style="-fx-font-size: 10px; -fx-font-weight: bold;" text="" textFill="#4da6ff" />
               </VBox>

            </VBox>

            <!-- Thin divider -->
            <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.07);">
               <VBox.margin><Insets bottom="6.0" left="10.0" right="10.0" /></VBox.margin>
            </Region>

            <!-- Logout -->
            <Button fx:id="logOutButton" maxWidth="1.7976931348623157E308" onAction="#handleLogOutClick" prefHeight="40.0" style="-fx-background-color: rgba(200,50,50,0.15); -fx-text-fill: #ff8080; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: rgba(255,100,100,0.25); -fx-border-width: 1; -fx-cursor: hand;" text="LOG OUT">
               <VBox.margin><Insets bottom="14.0" left="10.0" right="10.0" /></VBox.margin>
            </Button>
         </VBox>
      </left>

      <!-- ─────────────────── CENTER MAIN ─────────────────── -->
      <center>
         <VBox spacing="14.0" style="-fx-padding: 26 20 24 26;">

            <!-- Title row + activity panel toggle -->
            <HBox alignment="CENTER_LEFT">
               <Label style="-fx-font-size: 26px; -fx-font-weight: bold;" text="Dashboard" textFill="#e6f3ff" />
               <Region HBox.hgrow="ALWAYS" />
               <Button fx:id="activityToggleBtn" onAction="#handleToggleActivity" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: rgba(77,166,255,0.1); -fx-text-fill: #7fbfff; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(30,50,80,0.95); -fx-border-width: 1.5; -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 0;" text="›" />
            </HBox>

            <!-- Welcome label -->
            <Label fx:id="welcomeLabel" managed="false" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0;" text="Welcome back, Player!" textFill="#e6f3ff" visible="false" />

            <!-- Stats row -->
            <HBox spacing="12.0">
               <!-- Games card -->
               <HBox alignment="CENTER" prefHeight="72.0" spacing="10.0" style="-fx-background-color: rgba(10,25,50,0.85); -fx-background-radius: 14; -fx-border-color: rgba(77,166,255,0.2); -fx-border-width: 1; -fx-border-radius: 14; -fx-padding: 14 18;" HBox.hgrow="ALWAYS">
                  <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-underline: true;" text="3" textFill="#f0c040" />
                  <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="GAMES" textFill="#4da6ff" />
               </HBox>
               <!-- Wins card -->
               <HBox alignment="CENTER" prefHeight="72.0" spacing="10.0" style="-fx-background-color: rgba(10,25,50,0.85); -fx-background-radius: 14; -fx-border-color: rgba(77,166,255,0.2); -fx-border-width: 1; -fx-border-radius: 14; -fx-padding: 14 18;" HBox.hgrow="ALWAYS">
                  <Label fx:id="totalWinsLabel" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-underline: true;" text="0" textFill="#f0c040" />
                  <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="WINS" textFill="#4da6ff" />
               </HBox>
               <!-- Matches card -->
               <HBox alignment="CENTER" prefHeight="72.0" spacing="10.0" style="-fx-background-color: rgba(10,25,50,0.85); -fx-background-radius: 14; -fx-border-color: rgba(77,166,255,0.2); -fx-border-width: 1; -fx-border-radius: 14; -fx-padding: 14 18;" HBox.hgrow="ALWAYS">
                  <Label fx:id="totalMatchesLabel" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-underline: true;" text="0" textFill="#f0c040" />
                  <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="MATCHES" textFill="#4da6ff" />
               </HBox>
               <!-- Rank card -->
               <HBox alignment="CENTER" prefHeight="72.0" spacing="12.0" style="-fx-background-color: rgba(10,25,50,0.85); -fx-background-radius: 14; -fx-border-color: rgba(77,166,255,0.2); -fx-border-width: 1; -fx-border-radius: 14; -fx-padding: 14 18;" HBox.hgrow="ALWAYS">
                  <ImageView fx:id="rankStatShieldImage" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../images/BronzeRankShield.png" /></image>
                  </ImageView>
                  <VBox alignment="CENTER_LEFT" spacing="2.0">
                     <Label fx:id="rankStatLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="—" textFill="#4da6ff" />
                     <Label fx:id="mmrStatLabel" style="-fx-font-size: 10px;" text="500 MMR" textFill="#3d6080" />
                  </VBox>
               </HBox>
            </HBox>

            <!-- Available Games -->
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Available Games" textFill="#e6f3ff" />

            <HBox spacing="12.0">

               <!-- Tic-Tac-Toe -->
               <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                  <VBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 0;">
                     <ImageView fitHeight="165.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../images/TicTacToeCard.png" /></image>
                     </ImageView>
                  </VBox>
                  <Button maxWidth="1.7976931348623157E308" onAction="#handlePlayClick" prefHeight="38.0" style="-fx-background-color: linear-gradient(to right, #4da6ff, #1e90ff); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand;" text="▶  PLAY" userData="TicTacToe" />
               </VBox>

               <!-- Connect Four -->
               <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                  <VBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 0;">
                     <ImageView fitHeight="165.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../images/Connect4Card.png" /></image>
                     </ImageView>
                  </VBox>
                  <Button maxWidth="1.7976931348623157E308" onAction="#handlePlayClick" prefHeight="38.0" style="-fx-background-color: linear-gradient(to right, #4da6ff, #1e90ff); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand;" text="▶  PLAY" userData="ConnectFour" />
               </VBox>

               <!-- Checkers -->
               <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                  <VBox alignment="CENTER" style="-fx-background-color: transparent; -fx-padding: 0;">
                     <ImageView fitHeight="165.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../images/CheckersCard.png" /></image>
                     </ImageView>
                  </VBox>
                  <Button maxWidth="1.7976931348623157E308" onAction="#handlePlayClick" prefHeight="38.0" style="-fx-background-color: linear-gradient(to right, #4da6ff, #1e90ff); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand;" text="▶  PLAY" userData="Checkers" />
               </VBox>

               <!-- Coming soon -->
               <VBox spacing="8.0" HBox.hgrow="ALWAYS" />

            </HBox>

            <!-- Image carousel -->
            <StackPane fx:id="imageCarousel" style="-fx-background-radius: 14; -fx-background-color: transparent;">
               <VBox.margin><Insets top="25.0" /></VBox.margin>
            </StackPane>

         </VBox>
      </center>

      <!-- ─────────────────── RIGHT ACTIVITY PANEL ─────────────────── -->
      <right>
         <VBox fx:id="rightPanel" prefWidth="240.0" style="-fx-background-color: rgba(5,10,20,0.75); -fx-border-color: rgba(77,166,255,0.1); -fx-border-width: 0 0 0 1; -fx-padding: 26 16 20 16;">

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Activity" textFill="#e6f3ff" />

            <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.08);">
               <VBox.margin><Insets bottom="4.0" top="8.0" /></VBox.margin>
            </Region>

            <!-- Recently Played -->
            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Recently Played" textFill="#b9d9ff">
               <VBox.margin><Insets bottom="6.0" top="10.0" /></VBox.margin>
            </Label>
            <VBox fx:id="recentlyPlayedList" spacing="8.0" />

            <!-- Win Stats -->
            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Win Stats" textFill="#b9d9ff">
               <VBox.margin><Insets bottom="6.0" top="16.0" /></VBox.margin>
            </Label>
            <VBox fx:id="winStatsList" spacing="8.0" />

            <!-- Leaderboard -->
            <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.08);">
               <VBox.margin><Insets bottom="4.0" top="16.0" /></VBox.margin>
            </Region>

            <HBox alignment="CENTER_LEFT" spacing="6.0" style="-fx-background-color: rgba(10,25,45,0.8); -fx-background-radius: 8; -fx-border-color: rgba(77,166,255,0.18); -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 5 10;">
               <VBox.margin><Insets bottom="2.0" top="10.0" /></VBox.margin>
               <Label style="-fx-font-size: 13px;" text="⌕" textFill="#3d6080" />
               <TextField fx:id="leaderboardSearch" promptText="Search player…" style="-fx-background-color: transparent; -fx-text-fill: #e6f3ff; -fx-prompt-text-fill: #3d6080; -fx-font-size: 11px; -fx-border-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS" />
            </HBox>

            <Label fx:id="leaderboardHeader" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Leaderboard" textFill="#b9d9ff">
               <VBox.margin><Insets bottom="6.0" top="6.0" /></VBox.margin>
            </Label>
            <ScrollPane fx:id="leaderboardScroll" fitToWidth="true" hbarPolicy="NEVER" maxHeight="340.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
               <VBox fx:id="leaderboardList" spacing="8.0" style="-fx-background-color: transparent; -fx-padding: 0 2 4 0;" />
            </ScrollPane>

         </VBox>
      </right>

   </BorderPane>

   <!-- ══════════════════════════ SETTINGS OVERLAY ══════════════════════════ -->
   <StackPane fx:id="settingsOverlay" managed="false" visible="false">

      <!-- Dim background -->
      <Region onMouseClicked="#handleOverlayDimClick" style="-fx-background-color: rgba(0,0,0,0.55);" />

      <!-- Unified card: settings content + expandable side pane -->
      <HBox alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" onMouseClicked="#consumeOverlayClick" spacing="0.0" style="-fx-background-color: rgba(8,20,42,0.98); -fx-background-radius: 20;                    -fx-border-color: rgba(77,166,255,0.3); -fx-border-width: 1;                    -fx-border-radius: 20;                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.65), 32, 0, 0, 10);">

         <!-- ─── Main settings content ─── -->
         <VBox alignment="TOP_LEFT" prefWidth="440.0" spacing="0.0" style="-fx-padding: 24; -fx-background-color: transparent;">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT">
               <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="SETTINGS" textFill="#e6f3ff" />
               <Region HBox.hgrow="ALWAYS" />
               <Button onAction="#handleCloseSettings" prefHeight="28.0" prefWidth="28.0" style="-fx-background-color: rgba(77,166,255,0.1); -fx-text-fill: #7fbfff; -fx-font-size: 13px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0;" text="✕" />
            </HBox>

            <!-- Notification pill -->
            <HBox fx:id="settingsNotification" alignment="CENTER" managed="false" spacing="6.0" style="-fx-background-color: rgba(30,144,40,0.25); -fx-background-radius: 20; -fx-padding: 6 16; -fx-border-color: rgba(50,200,80,0.4); -fx-border-radius: 20; -fx-border-width: 1;" visible="false">
               <VBox.margin><Insets top="10.0" /></VBox.margin>
               <Label fx:id="settingsNotificationLabel" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #40d090;" text="" />
            </HBox>

            <!-- Divider -->
            <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.15);">
               <VBox.margin><Insets bottom="14.0" top="14.0" /></VBox.margin>
            </Region>

            <!-- USERNAME -->
            <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="USERNAME" textFill="#3d6080">
               <VBox.margin><Insets bottom="6.0" /></VBox.margin>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <VBox.margin><Insets bottom="16.0" /></VBox.margin>
               <TextField fx:id="settingsUsernameField" editable="false" prefHeight="44.0" style="-fx-background-color: rgba(10,25,45,0.9); -fx-text-fill: #b9d9ff; -fx-prompt-text-fill: #3d6080; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.2); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 10 12;" HBox.hgrow="ALWAYS" />
               <Button fx:id="settingsEditBtn" onAction="#handleSettingsEdit" prefHeight="44.0" prefWidth="66.0" style="-fx-background-color: rgba(77,166,255,0.15); -fx-text-fill: #4da6ff; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.3); -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;" text="Edit" />
               <Button fx:id="settingsSaveBtn" managed="false" onAction="#handleSettingsSave" prefHeight="44.0" prefWidth="66.0" style="-fx-background-color: linear-gradient(to right,#1e90ff,#4da6ff); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-border-color: transparent; -fx-border-width: 0; -fx-border-radius: 10; -fx-cursor: hand;" text="Save" visible="false" />
            </HBox>

            <!-- Divider -->
            <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.1);">
               <VBox.margin><Insets bottom="14.0" /></VBox.margin>
            </Region>

            <!-- CHANGE PASSWORD -->
            <Button fx:id="changePasswordBtn" maxWidth="1.7976931348623157E308" onAction="#handleTogglePasswordPane" prefHeight="44.0" style="-fx-background-color: rgba(10,25,45,0.9); -fx-text-fill: #b9d9ff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 0 16; -fx-cursor: hand;" text="CHANGE PASSWORD">
               <VBox.margin><Insets bottom="8.0" /></VBox.margin>
            </Button>

            <!-- CHANGE AVATAR -->
            <Button fx:id="changeAvatarBtn" maxWidth="1.7976931348623157E308" onAction="#handleToggleAvatarPane" prefHeight="44.0" style="-fx-background-color: rgba(10,25,45,0.9); -fx-text-fill: #b9d9ff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.15); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 0 16; -fx-cursor: hand;" text="CHANGE AVATAR" />

         </VBox>

         <!-- Thin divider between settings and side pane -->
         <Region fx:id="sidePaneDivider" managed="false" maxWidth="1.0" minWidth="1.0" prefWidth="1.0" style="-fx-background-color: rgba(77,166,255,0.2);" visible="false">
            <HBox.margin><Insets bottom="20.0" top="20.0" /></HBox.margin>
         </Region>

         <!-- ─── Password side pane ─── -->
         <VBox fx:id="passwordPane" alignment="TOP_LEFT" managed="false" prefWidth="300.0" spacing="0.0" style="-fx-padding: 24; -fx-background-color: transparent;" visible="false">

            <HBox alignment="CENTER_LEFT">
               <VBox.margin><Insets bottom="16.0" /></VBox.margin>
               <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="CHANGE PASSWORD" textFill="#e6f3ff" />
               <Region HBox.hgrow="ALWAYS" />
               <Button onAction="#handleTogglePasswordPane" prefHeight="28.0" prefWidth="28.0" style="-fx-background-color: rgba(77,166,255,0.1); -fx-text-fill: #7fbfff; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0;" text="‹" />
            </HBox>

            <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="CURRENT PASSWORD" textFill="#3d6080">
               <VBox.margin><Insets bottom="4.0" /></VBox.margin>
            </Label>
            <PasswordField fx:id="oldPasswordField" prefHeight="44.0" promptText="Enter current password" style="-fx-background-color: rgba(10,25,45,0.9); -fx-text-fill: #b9d9ff; -fx-prompt-text-fill: #3d6080; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.2); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 10 12;">
               <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </PasswordField>

            <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="NEW PASSWORD" textFill="#3d6080">
               <VBox.margin><Insets bottom="4.0" /></VBox.margin>
            </Label>
            <PasswordField fx:id="newPasswordField" prefHeight="44.0" promptText="Enter new password" style="-fx-background-color: rgba(10,25,45,0.9); -fx-text-fill: #b9d9ff; -fx-prompt-text-fill: #3d6080; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.2); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 10 12;">
               <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </PasswordField>

            <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="CONFIRM NEW PASSWORD" textFill="#3d6080">
               <VBox.margin><Insets bottom="4.0" /></VBox.margin>
            </Label>
            <PasswordField fx:id="confirmPasswordField" prefHeight="44.0" promptText="Confirm new password" style="-fx-background-color: rgba(10,25,45,0.9); -fx-text-fill: #b9d9ff; -fx-prompt-text-fill: #3d6080; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.2); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 10 12;">
               <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </PasswordField>

            <Label fx:id="passwordErrorLabel" style="-fx-font-size: 11px;" text="" textFill="#ff6b6b" wrapText="true">
               <VBox.margin><Insets bottom="8.0" /></VBox.margin>
            </Label>

            <Button maxWidth="1.7976931348623157E308" onAction="#handleSavePassword" prefHeight="42.0" style="-fx-background-color: linear-gradient(to right,#1e90ff,#4da6ff); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-cursor: hand;" text="UPDATE PASSWORD" />
         </VBox>

         <!-- ─── Avatar side pane ─── -->
         <VBox fx:id="avatarPane" alignment="TOP_LEFT" managed="false" prefWidth="300.0" spacing="0.0" style="-fx-padding: 24; -fx-background-color: transparent;" visible="false">

            <HBox alignment="CENTER_LEFT">
               <VBox.margin><Insets bottom="8.0" /></VBox.margin>
               <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="CHANGE AVATAR" textFill="#e6f3ff" />
               <Region HBox.hgrow="ALWAYS" />
               <Button onAction="#handleToggleAvatarPane" prefHeight="28.0" prefWidth="28.0" style="-fx-background-color: rgba(77,166,255,0.1); -fx-text-fill: #7fbfff; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0;" text="‹" />
            </HBox>

            <HBox fx:id="avatarNotification" alignment="CENTER" managed="false" spacing="6.0" style="-fx-background-color: rgba(30,144,40,0.25); -fx-background-radius: 20; -fx-padding: 5 14; -fx-border-color: rgba(50,200,80,0.4); -fx-border-radius: 20; -fx-border-width: 1;" visible="false">
               <VBox.margin><Insets bottom="8.0" /></VBox.margin>
               <Label fx:id="avatarNotificationLabel" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5ddb7a;" text="Avatar updated!" />
            </HBox>

            <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="CURRENT" textFill="#3d6080">
               <VBox.margin><Insets bottom="6.0" /></VBox.margin>
            </Label>
            <StackPane alignment="CENTER_LEFT" prefHeight="64.0">
               <VBox.margin><Insets bottom="16.0" /></VBox.margin>
               <StackPane prefHeight="56.0" prefWidth="56.0" style="-fx-background-color: rgba(10,25,45,0.92); -fx-background-radius: 28; -fx-border-color: rgba(77,166,255,0.4); -fx-border-width: 1.5; -fx-border-radius: 28;" StackPane.alignment="CENTER_LEFT">
                  <ImageView fx:id="settingsCurrentAvatarImage" fitHeight="56.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../images/gameDinoLogo.png" /></image>
                     <clip><Circle centerX="28.0" centerY="28.0" radius="28.0" /></clip>
                  </ImageView>
               </StackPane>
            </StackPane>

            <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="SELECT NEW AVATAR" textFill="#3d6080">
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <StackPane fx:id="settingsAvatarCard1" onMouseClicked="#handleSelectSettingsAvatar1" prefHeight="50.0" prefWidth="50.0" style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-border-width: 2; -fx-border-color: rgba(77,166,255,0.3); -fx-cursor: hand;">
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../images/avatar1.png" /></image>
                     <clip><Circle centerX="25.0" centerY="25.0" radius="25.0" /></clip>
                  </ImageView>
               </StackPane>
               <StackPane fx:id="settingsAvatarCard2" onMouseClicked="#handleSelectSettingsAvatar2" prefHeight="50.0" prefWidth="50.0" style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-border-width: 2; -fx-border-color: rgba(77,166,255,0.3); -fx-cursor: hand;">
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../images/avatar2.png" /></image>
                     <clip><Circle centerX="25.0" centerY="25.0" radius="25.0" /></clip>
                  </ImageView>
               </StackPane>
               <StackPane fx:id="settingsAvatarCard3" onMouseClicked="#handleSelectSettingsAvatar3" prefHeight="50.0" prefWidth="50.0" style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-border-width: 2; -fx-border-color: rgba(77,166,255,0.3); -fx-cursor: hand;">
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../images/avatar3.png" /></image>
                     <clip><Circle centerX="25.0" centerY="25.0" radius="25.0" /></clip>
                  </ImageView>
               </StackPane>
               <StackPane fx:id="settingsAvatarCard4" onMouseClicked="#handleSelectSettingsAvatar4" prefHeight="50.0" prefWidth="50.0" style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-border-width: 2; -fx-border-color: rgba(77,166,255,0.3); -fx-cursor: hand;">
                  <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image><Image url="@../images/avatar4.png" /></image>
                     <clip><Circle centerX="25.0" centerY="25.0" radius="25.0" /></clip>
                  </ImageView>
               </StackPane>
            </HBox>

         </VBox>

      </HBox>

      <!-- ─── Unsaved changes warning ─── -->
      <StackPane fx:id="unsavedWarningOverlay" managed="false" visible="false">
         <Region style="-fx-background-color: rgba(0,0,0,0.65);" />
         <VBox alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="320.0" onMouseClicked="#consumeOverlayClick" spacing="0.0" style="-fx-background-color: rgba(8,20,42,0.98); -fx-background-radius: 16; -fx-border-color: rgba(77,166,255,0.3); -fx-border-width: 1; -fx-border-radius: 16; -fx-padding: 24; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 24, 0, 0, 6);">

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Unsaved Changes" textFill="#e6f3ff">
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>
            <Label style="-fx-font-size: 12px;" text="You have unsaved changes. What would you like to do?" textFill="#7fbfff" wrapText="true">
               <VBox.margin><Insets bottom="20.0" /></VBox.margin>
            </Label>

            <Button maxWidth="1.7976931348623157E308" onAction="#handleCloseWithoutSaving" prefHeight="42.0" style="-fx-background-color: rgba(200,50,50,0.15); -fx-text-fill: #ff8080; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-color: rgba(255,100,100,0.25); -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;" text="Close without saving">
               <VBox.margin><Insets bottom="8.0" /></VBox.margin>
            </Button>
            <Button maxWidth="1.7976931348623157E308" onAction="#handleContinueEditing" prefHeight="42.0" style="-fx-background-color: rgba(77,166,255,0.15); -fx-text-fill: #4da6ff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.3); -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;" text="Continue editing" />

         </VBox>
      </StackPane>

   </StackPane>

   <!-- ══════════════════════════ FRIENDS LIST OVERLAY ══════════════════════════ -->
   <StackPane fx:id="friendsOverlay" managed="false" visible="false">

      <!-- Dim background -->
      <Region onMouseClicked="#handleFriendsOverlayDimClick" style="-fx-background-color: rgba(0,0,0,0.55);" />

      <!-- Friends card -->
      <VBox alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" onMouseClicked="#consumeOverlayClick" prefWidth="420.0" spacing="0.0" style="-fx-background-color: rgba(8,20,42,0.98); -fx-background-radius: 20;                 -fx-border-color: rgba(77,166,255,0.3); -fx-border-width: 1;                 -fx-border-radius: 20;                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.65), 32, 0, 0, 10);                 -fx-padding: 24;">

         <!-- Header -->
         <HBox alignment="CENTER_LEFT">
            <VBox.margin><Insets bottom="14.0" /></VBox.margin>
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="FRIENDS" textFill="#e6f3ff" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleCloseFriends" prefHeight="28.0" prefWidth="28.0" style="-fx-background-color: rgba(77,166,255,0.1); -fx-text-fill: #7fbfff; -fx-font-size: 13px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0;" text="✕" />
         </HBox>

         <!-- Add friend row -->
         <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: rgba(10,25,45,0.8); -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.18); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 6 10;">
            <VBox.margin><Insets bottom="14.0" /></VBox.margin>
            <Label style="-fx-font-size: 13px;" text="＋" textFill="#4da6ff" />
            <TextField fx:id="addFriendField" promptText="Search by username to add friend…" style="-fx-background-color: transparent; -fx-text-fill: #e6f3ff; -fx-prompt-text-fill: #3d6080; -fx-font-size: 12px; -fx-border-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS" />
            <Button fx:id="addFriendBtn" onAction="#handleAddFriend" prefHeight="30.0" prefWidth="60.0" style="-fx-background-color: linear-gradient(to right, #1e90ff, #4da6ff); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 8; -fx-cursor: hand;" text="Add" />
         </HBox>

         <!-- Notification pill -->
         <HBox fx:id="friendsNotification" alignment="CENTER" managed="false" spacing="6.0" style="-fx-background-color: rgba(30,144,40,0.25); -fx-background-radius: 20; -fx-padding: 6 16; -fx-border-color: rgba(50,200,80,0.4); -fx-border-radius: 20; -fx-border-width: 1;" visible="false">
            <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            <Label fx:id="friendsNotificationLabel" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #40d090;" text="" />
         </HBox>

         <!-- Divider -->
         <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.15);">
            <VBox.margin><Insets bottom="12.0" /></VBox.margin>
         </Region>

         <!-- Pending requests section (populated dynamically) -->
         <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="REQUESTS" textFill="#f0c040">
            <VBox.margin><Insets bottom="8.0" /></VBox.margin>
         </Label>
         <VBox fx:id="pendingRequestsList" spacing="8.0">
            <VBox.margin><Insets bottom="14.0" /></VBox.margin>
         </VBox>

         <!-- Online friends section (populated dynamically) -->
         <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="ONLINE" textFill="#40d090">
            <VBox.margin><Insets bottom="8.0" /></VBox.margin>
         </Label>
         <VBox fx:id="onlineFriendsList" spacing="8.0">
            <VBox.margin><Insets bottom="14.0" /></VBox.margin>
         </VBox>

         <!-- Offline friends section (populated dynamically) -->
         <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="OFFLINE" textFill="#3d6080">
            <VBox.margin><Insets bottom="8.0" /></VBox.margin>
         </Label>
         <VBox fx:id="offlineFriendsList" spacing="8.0" />

      </VBox>

   </StackPane>

</StackPane>
