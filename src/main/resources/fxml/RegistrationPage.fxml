<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="649.0" prefWidth="640.0" style="-fx-background-color: linear-gradient(to bottom right, #0b1f33, #4da6ff);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.ui.controllers.RegistrationPageController">
   <children>

      <VBox alignment="CENTER" layoutX="130.0" layoutY="55.0" prefWidth="380.0" spacing="14.0" style="-fx-background-color: rgba(10,25,45,0.92); -fx-background-radius: 20; -fx-border-color: rgba(77,166,255,0.25); -fx-border-width: 1.2; -fx-border-radius: 20; -fx-padding: 30;">
         <children>

            <!-- Title -->
            <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="CREATE ACCOUNT" textFill="#e6f3ff" />
            <Label style="-fx-font-size: 13px;" text="Sign up to get started" textFill="#aad4ff" />
            <Region prefHeight="8.0" />

            <!-- First Name and Last Name side by side -->
            <HBox spacing="10.0">
               <children>
                  <VBox alignment="TOP_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: 700;" text="First Name" textFill="#E2E8F0" />
                        <TextField fx:id="firstName" maxWidth="1.7976931348623157E308" prefHeight="42.0" promptText="First name" style="-fx-background-color: #0f2942; -fx-text-fill: white; -fx-prompt-text-fill: #7fbfff; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(77,166,255,0.25); -fx-padding: 0 12 0 12;" />
                     </children>
                  </VBox>
                  <VBox alignment="TOP_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: 700;" text="Last Name" textFill="#E2E8F0" />
                        <TextField fx:id="lastName" maxWidth="1.7976931348623157E808" prefHeight="42.0" promptText="Last name" style="-fx-background-color: #0f2942; -fx-text-fill: white; -fx-prompt-text-fill: #7fbfff; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(77,166,255,0.25); -fx-padding: 0 12 0 12;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Password -->
            <VBox alignment="TOP_LEFT" prefWidth="320.0" spacing="8.0">
               <children>
                  <Label style="-fx-font-size: 14px; -fx-font-weight: 700;" text="Password" textFill="#E2E8F0" />
                  <HBox alignment="CENTER_LEFT" spacing="6">
                     <PasswordField fx:id="password" HBox.hgrow="ALWAYS" prefHeight="42.0" promptText="Enter password" style="-fx-background-color: #0f2942; -fx-text-fill: white; -fx-prompt-text-fill: #7fbfff; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(77,166,255,0.25); -fx-padding: 0 12 0 12;" />
                     <TextField fx:id="passwordVisible" HBox.hgrow="ALWAYS" prefHeight="42.0" promptText="Enter password" style="-fx-background-color: #0f2942; -fx-text-fill: white; -fx-prompt-text-fill: #7fbfff; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(77,166,255,0.25); -fx-padding: 0 12 0 12;" />
                     <Button fx:id="viewPasswordButton" onAction="#handleViewPassword" style="-fx-background-color: transparent; -fx-font-size: 14px; -fx-cursor: hand;" text="👁" />
                  </HBox>
                  <Label text="Min 8 chars · uppercase · lowercase · number · special character" textFill="#6b8099" style="-fx-font-size: 10px;" />
               </children>
            </VBox>

            <!-- Confirm Password -->
            <VBox alignment="TOP_LEFT" prefWidth="320.0" spacing="8.0">
               <children>
                  <Label style="-fx-font-size: 14px; -fx-font-weight: 700;" text="Confirm Password" textFill="#E2E8F0" />
                  <PasswordField fx:id="confirmPassword" maxWidth="1.7976931348623157E308" prefHeight="42.0" promptText="Confirm password" style="-fx-background-color: #0f2942; -fx-text-fill: white; -fx-prompt-text-fill: #7fbfff; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: rgba(77,166,255,0.25); -fx-padding: 0 12 0 12;" />
               </children>
            </VBox>

            <!-- Error Label -->
            <Label fx:id="errorLabel" style="-fx-font-size: 11px;" text="" textFill="#ff6b6b" />

            <!-- Sign Up Button -->
            <Button fx:id="signUpButton" maxWidth="1.7976931348623157E308" onAction="#handleSignUpClick" prefHeight="45.0" style="-fx-background-color: linear-gradient(to right, #4da6ff, #1e90ff); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 12;" text="SIGN UP" />

            <!-- Sign In link -->
            <HBox alignment="CENTER" spacing="5">
               <children>
                  <Label text="Already a user?" textFill="#cfe8ff" />
                  <Hyperlink fx:id="signInButton" onAction="#handleSignInClick" style="-fx-text-fill: #4da6ff; -fx-font-weight: bold;" text="Sign In" />
               </children>
            </HBox>

         </children>
      </VBox>

   </children>
</AnchorPane>