<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane prefHeight="640.0" prefWidth="1060.0" style="-fx-background-color: linear-gradient(to bottom right, #0b1f33, #4da6ff);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ca.ucalgary.seng300.ui.controllers.TicTacToeGamePageController">

    <!-- ══════════════════════════ MAIN LAYOUT ══════════════════════════ -->
    <BorderPane>

        <!-- ─────────────────── HEADER ─────────────────── -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-background-color: rgba(5,12,24,0.97); -fx-border-color: rgba(77,166,255,0.1); -fx-border-width: 0 0 1 0; -fx-padding: 16 24;">
                <Button onAction="#handleBackToDashboard" prefHeight="32.0" style="-fx-background-color: rgba(77,166,255,0.12); -fx-text-fill: #7fbfff; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: rgba(77,166,255,0.25); -fx-border-width: 1; -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 0 14;" text="← Back" />
                <ImageView fitHeight="26.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../images/GameDinoLogoShort.png" /></image>
                </ImageView>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Tic-Tac-Toe" textFill="#e6f3ff" />
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="#" textFill="#4da6ff" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="sessionIdLabel" style="-fx-font-size: 10px;" text="" textFill="#3d6080" />
            </HBox>
        </top>

        <!-- ─────────────────── LEFT PANEL ─────────────────── -->
        <left>
            <VBox prefWidth="200.0" spacing="0.0" style="-fx-background-color: rgba(5,12,24,0.97); -fx-border-color: rgba(77,166,255,0.07); -fx-border-width: 0 1 0 0; -fx-padding: 28 16 24 16;">

                <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="PLAYERS" textFill="#3d6080">
                    <VBox.margin><Insets bottom="12.0" /></VBox.margin>
                </Label>

                <!-- Player 1 card (X) -->
                <VBox fx:id="player1Card" spacing="4.0" style="-fx-background-color: rgba(77,166,255,0.12); -fx-background-radius: 12; -fx-border-color: rgba(77,166,255,0.4); -fx-border-width: 1.5; -fx-border-radius: 12; -fx-padding: 12 14;">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="X" textFill="#4da6ff" />
                        <VBox spacing="1.0">
                            <Label fx:id="player1Label" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Player 1" textFill="#e6f3ff" />
                            <Label style="-fx-font-size: 10px;" text="Crosses" textFill="#3d6080" />
                        </VBox>
                    </HBox>
                    <Label fx:id="player1TurnLabel" style="-fx-font-size: 10px; -fx-font-weight: bold;" text="Your turn" textFill="#4da6ff" />
                </VBox>

                <Region maxHeight="10.0" prefHeight="10.0" />

                <!-- VS divider -->
                <HBox alignment="CENTER" spacing="8.0">
                    <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.1);" HBox.hgrow="ALWAYS" />
                    <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="VS" textFill="#3d6080" />
                    <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.1);" HBox.hgrow="ALWAYS" />
                </HBox>

                <Region maxHeight="10.0" prefHeight="10.0" />

                <!-- Player 2 card (O) -->
                <VBox fx:id="player2Card" spacing="4.0" style="-fx-background-color: rgba(10,25,45,0.8); -fx-background-radius: 12; -fx-border-color: rgba(77,166,255,0.15); -fx-border-width: 1; -fx-border-radius: 12; -fx-padding: 12 14;">
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="O" textFill="#ff8040" />
                        <VBox spacing="1.0">
                            <Label fx:id="player2Label" style="-fx-font-size: 12px; -fx-font-weight: bold;" text="Player 2" textFill="#b9d9ff" />
                            <Label style="-fx-font-size: 10px;" text="Noughts" textFill="#3d6080" />
                        </VBox>
                    </HBox>
                    <Label fx:id="player2TurnLabel" style="-fx-font-size: 10px;" text="Waiting..." textFill="#3d6080" />
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <!-- Turn status -->
                <VBox spacing="6.0" style="-fx-background-color: rgba(10,25,45,0.8); -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.12); -fx-border-width: 1; -fx-border-radius: 10; -fx-padding: 12 14;">
                    <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="TURN" textFill="#3d6080" />
                    <Label fx:id="turnStatusLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="X to move" textFill="#e6f3ff" />
                    <Label fx:id="moveCountLabel" style="-fx-font-size: 10px;" text="Move 1" textFill="#3d6080" />
                </VBox>
            </VBox>
        </left>

        <!-- ─────────────────── CENTER BOARD ─────────────────── -->
        <center>
            <StackPane fx:id="boardContainer" alignment="CENTER" style="-fx-padding: 40;" />
        </center>

        <!-- ─────────────────── RIGHT PANEL — CHAT ─────────────────── -->
        <right>
            <VBox prefWidth="220.0" spacing="0.0" style="-fx-background-color: rgba(5,12,24,0.97); -fx-border-color: rgba(77,166,255,0.07); -fx-border-width: 0 0 0 1; -fx-padding: 20 14 14 14;">

                <!-- Header row -->
                <HBox alignment="CENTER_LEFT" spacing="6.0">
                    <Label style="-fx-font-size: 11px;" text="💬" />
                    <Label style="-fx-font-size: 10px; -fx-font-weight: bold;" text="CHAT" textFill="#3d6080" />
                </HBox>
                <Region maxHeight="1.0" prefHeight="1.0" style="-fx-background-color: rgba(77,166,255,0.1);">
                    <VBox.margin><Insets bottom="10.0" top="8.0" /></VBox.margin>
                </Region>

                <!-- Message scroll area -->
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: rgba(5,15,35,0.8); -fx-background-color: rgba(5,15,35,0.8); -fx-border-color: rgba(77,166,255,0.12); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                    <VBox fx:id="chatMessagesBox" fillWidth="true" spacing="5.0" style="-fx-background-color: transparent; -fx-padding: 8 6;" />
                </ScrollPane>

                <Region maxHeight="10.0" prefHeight="10.0" />

                <!-- Input row -->
                <HBox alignment="CENTER" spacing="6.0">
                    <TextField fx:id="chatInputField" onAction="#handleSendChat" promptText="Say something…" style="-fx-background-color: rgba(8,20,45,0.9); -fx-text-fill: #e6f3ff; -fx-prompt-text-fill: #3d6080; -fx-border-color: rgba(77,166,255,0.18); -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 7 10; -fx-font-size: 11px;" HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleSendChat" prefHeight="34.0" prefWidth="34.0" style="-fx-background-color: rgba(77,166,255,0.18); -fx-text-fill: #4da6ff; -fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: rgba(77,166,255,0.25); -fx-border-width: 1; -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 0;" text="➤" />
                </HBox>
            </VBox>
        </right>

    </BorderPane>

    <!-- ══════════════════════════ TURN NOTIFICATION BADGE ══════════════════════════ -->
    <HBox fx:id="turnBadge" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="10.0" style="-fx-background-color: rgba(8,20,42,0.96); -fx-background-radius: 24; -fx-border-color: rgba(77,166,255,0.45); -fx-border-width: 1.5; -fx-border-radius: 24; -fx-padding: 7 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 16, 0, 0, 4);" visible="false" StackPane.alignment="TOP_CENTER">
        <StackPane.margin><Insets top="70.0" /></StackPane.margin>
        <Label fx:id="turnBadgeIcon" style="-fx-font-size: 12px;" text="▶" textFill="#4da6ff" />
        <Label fx:id="turnBadgeLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="X to move" textFill="#e6f3ff" />
        <Button onAction="#handleDismissBadge" prefHeight="22.0" prefWidth="22.0" style="-fx-background-color: rgba(77,166,255,0.15); -fx-text-fill: #7fbfff; -fx-font-size: 10px; -fx-background-radius: 11; -fx-cursor: hand; -fx-padding: 0;" text="✕" />
    </HBox>

    <!-- ══════════════════════════ GAME OVER OVERLAY ══════════════════════════ -->
    <!-- ══════════════════════════ FORFEIT WARNING OVERLAY ══════════════════════════ -->
    <StackPane fx:id="forfeitOverlay" managed="false" visible="false">
        <Region style="-fx-background-color: rgba(0,0,0,0.65);" />
        <VBox alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="340.0" spacing="0.0" style="-fx-background-color: rgba(8,20,42,0.98); -fx-background-radius: 18; -fx-border-color: rgba(255,100,100,0.4); -fx-border-width: 1; -fx-border-radius: 18; -fx-padding: 28 28 22 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 30, 0, 0, 8);">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="⚠  Leave Game?" textFill="#ff8080">
                <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>
            <Label style="-fx-font-size: 12px;" text="If you leave now you will forfeit the match. You will receive a loss and your opponent will be awarded the win." textFill="#7fbfff" wrapText="true">
                <VBox.margin><Insets bottom="24.0" /></VBox.margin>
            </Label>
            <Button maxWidth="1.7976931348623157E308" onAction="#handleConfirmForfeit" prefHeight="42.0" style="-fx-background-color: rgba(200,50,50,0.2); -fx-text-fill: #ff8080; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-color: rgba(255,100,100,0.35); -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;" text="Leave &amp; Forfeit">
                <VBox.margin><Insets bottom="8.0" /></VBox.margin>
            </Button>
            <Button maxWidth="1.7976931348623157E308" onAction="#handleCancelForfeit" prefHeight="42.0" style="-fx-background-color: rgba(77,166,255,0.15); -fx-text-fill: #4da6ff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 10; -fx-border-color: rgba(77,166,255,0.3); -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;" text="Stay in Game" />
        </VBox>
    </StackPane>

    <!-- ══════════════════════════ GAME OVER OVERLAY ══════════════════════════ -->
    <StackPane fx:id="gameOverOverlay" managed="false" visible="false">
        <Region style="-fx-background-color: rgba(0,0,0,0.75);" />
        <!-- gameOverCard content is built entirely in the controller -->
        <VBox fx:id="gameOverCard" alignment="CENTER" maxHeight="-Infinity" maxWidth="380.0" spacing="0.0" style="-fx-background-color: rgba(8,20,42,0.98); -fx-background-radius: 22;                    -fx-border-color: rgba(77,166,255,0.35); -fx-border-width: 1; -fx-border-radius: 22;                    -fx-padding: 36 36 28 36;                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.7), 40, 0, 0, 10);" />
    </StackPane>

    <!-- ══════════════════════════ PLAY-AGAIN WAITING OVERLAY ══════════════════════════ -->
    <StackPane fx:id="playAgainWaitOverlay" managed="false" visible="false">
        <Region style="-fx-background-color: rgba(0,0,0,0.55);" />
        <VBox alignment="TOP_LEFT" maxHeight="-Infinity" maxWidth="320.0" spacing="0.0" style="-fx-background-color: rgba(8,20,42,0.98); -fx-background-radius: 16;                    -fx-border-color: rgba(77,166,255,0.3); -fx-border-width: 1; -fx-border-radius: 16;                    -fx-padding: 18 20 20 20;                    -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.6), 24, 0, 0, 6);">
            <!-- Title row with dismiss X -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Waiting…" textFill="#4da6ff" HBox.hgrow="ALWAYS" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="dismissWaitBtn" onAction="#handleDismissWait" prefHeight="24.0" prefWidth="24.0" style="-fx-background-color: rgba(77,166,255,0.12); -fx-text-fill: #7fbfff;                            -fx-font-size: 11px; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 0;" text="✕" />
            </HBox>
            <Region maxHeight="10.0" prefHeight="10.0" />
            <Label fx:id="waitingMessageLabel" style="-fx-font-size: 12px;" text="" textFill="#b9d9ff" wrapText="true">
                <VBox.margin><Insets bottom="4.0" /></VBox.margin>
            </Label>
            <Label style="-fx-font-size: 10px;" text="Dismiss to return to result screen." textFill="#3d6080" wrapText="true" />
        </VBox>
    </StackPane>

    <!-- ══════════════════════════ FORFEIT WIN TOAST ══════════════════════════ -->
    <HBox fx:id="forfeitToast" alignment="CENTER" managed="false" maxHeight="-Infinity" maxWidth="-Infinity" spacing="10.0" style="-fx-background-color: rgba(8,20,42,0.96); -fx-background-radius: 24; -fx-border-color: rgba(77,166,255,0.45); -fx-border-width: 1.5; -fx-border-radius: 24; -fx-padding: 7 14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 16, 0, 0, 4);" visible="false" StackPane.alignment="TOP_CENTER">
        <StackPane.margin><Insets top="70.0" /></StackPane.margin>
        <Label style="-fx-font-size: 12px;" text="▶" textFill="#4da6ff" />
        <Label fx:id="forfeitToastLabel" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="" textFill="#e6f3ff" />
    </HBox>

</StackPane>
